# Environment Configuration for Tessera
# Copy this file to .env and adjust as necessary.

PORT=8000
HOST=0.0.0.0

# Optional Demo Key for CoinGecko (keyless fallback works out of the box)
COINGECKO_API_KEY=

# Optional Zerodha Kite Connect Adapter (mock/yfinance fallback active by default)
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Cache Settings
CACHE_DB_PATH=app/core/cache.db
DEFAULT_CACHE_TTL_SECONDS=60
